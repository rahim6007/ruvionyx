# Local development only. Never commit real credentials.
POSTGRES_DB=ruvionyx
POSTGRES_USER=ruvionyx
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# API will use these after it is scaffolded.
DATABASE_URL=postgresql+psycopg://ruvionyx:change-this-local-password@localhost:5432/ruvionyx
REDIS_URL=redis://localhost:6379/0

# Add provider credentials only to your ignored local .env file.
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
